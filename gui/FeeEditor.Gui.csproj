<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>FeeEditor.Gui</AssemblyName>
    <RootNamespace>FeeEditor.Gui</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <ApplicationIcon>Assets/app-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="SukiUI" Version="7.0.1" />
    <ProjectReference Include="../core/Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization/*.json" WithCulture="false" />
    <AvaloniaResource Include="Assets/app-icon.png" />
    <AvaloniaResource Include="Assets/app-icon.ico" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <ProjectReference Include="../cli/Cli.csproj" />
    <TrimmerRootAssembly Include="FeeEditor.Gui" />
    <TrimmerRootAssembly Include="FeeEditor.Core" />
    <TrimmerRootAssembly Include="FeeEditor.Cli" />
  </ItemGroup>
</Project>
